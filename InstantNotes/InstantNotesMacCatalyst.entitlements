<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Mac Catalyst only. A Catalyst app runs sandboxed, so the capabilities the iOS build
	     gets implicitly have to be asked for by name here. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Meeting capture records from the microphone. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- The Notion importer opens a ZIP the user picks in the file dialog. -->
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
	<!-- A YouTube link is transcribed from captions fetched over the network. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Notes sync through the user's private iCloud database, with pushes for changes. -->
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.homezero1.instantnotes</string>
	</array>
	<key>com.apple.developer.aps-environment</key>
	<string>development</string>
</dict>
</plist>
