<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Mac Catalyst only. A Catalyst app runs sandboxed, so the capabilities the iOS build
	     gets implicitly have to be asked for by name here. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Gemini summaries, quizzes and tag suggestions are outbound HTTPS calls. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Meeting capture records from the microphone. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- The Notion importer opens a ZIP the user picks in the file dialog. -->
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
</dict>
</plist>
